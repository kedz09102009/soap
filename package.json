{
  "name": "soap-presentation",
  "type": "module",
  "private": true,
  "slidev": {
    "title": "SOAP Presentation",
    "description": "A presentation about SOAP",
    "theme": "seriph",
    "monaco": {
      "plugins": [
        "typescript",
        "javascript",
        "html",
        "css"
      ]
    }
  },
  "scripts": {
    "build": "slidev build --base /soap/",
    "dev": "slidev --open",
    "export": "slidev export"
  },
  "dependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "latest",
    "@slidev/theme-seriph": "latest",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
